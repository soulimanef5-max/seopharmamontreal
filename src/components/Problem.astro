---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang).problem;
---

<section class="py-20 md:py-28" style="background: var(--color-surface-alt);" aria-labelledby="problem-title">
  <div class="container grid lg:grid-cols-[2fr_3fr] gap-10 lg:gap-20">
    <div class="lg:sticky lg:top-28 self-start">
      <h2 class="section-title" id="problem-title" style="text-align: left;">{t.title}</h2>
      <p class="m-0" style="font-size: 1.0625rem; line-height: 1.7; color: var(--color-text-muted);">{t.lead}</p>
    </div>

    <ol class="list-none m-0 p-0">
      {t.pains.map((pain, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-4 py-8" style={`border-top: 1px solid var(--color-border);${i === t.pains.length - 1 ? ' border-bottom: 1px solid var(--color-border);' : ''}`}>
          <span aria-hidden="true" style="font-family: var(--font-family-heading); font-size: 1.5rem; font-weight: 700; color: var(--color-cta); line-height: 1.2;">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="mb-3" style="font-size: 1.25rem; color: var(--color-primary);">{pain.title}</h3>
            <p class="m-0" style="font-size: 1rem; line-height: 1.7; color: var(--color-text-muted); max-width: 60ch;">{pain.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
