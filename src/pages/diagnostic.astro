---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Booking from '../components/Booking.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';

const lang = 'fr';
const title = 'Flash Diagnostic visibilité Google + IA — 297 $ | PSN & santé';
const description = "Flash Diagnostic 297 $ CAD : où en est votre marque santé sur Google et dans les réponses IA (ChatGPT, Perplexity) ? 3 opportunités priorisées + 1 action immédiate, en une page.";

const canonical = 'https://seopharmamontreal.com/diagnostic/';

// ── Service + FAQ JSON-LD ──────────────────────────────────────────────────
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://seopharmamontreal.com/diagnostic/#service',
  name: 'Flash Diagnostic — Visibilité Google + IA pour marques de santé',
  serviceType: 'SEO & GEO Visibility Diagnostic',
  provider: { '@type': 'Organization', '@id': 'https://seopharmamontreal.com/#business' },
  areaServed: [
    { '@type': 'City', name: 'Montréal' },
    { '@type': 'State', name: 'Québec' },
    { '@type': 'Country', name: 'Canada' },
  ],
  description,
  offers: {
    '@type': 'Offer',
    price: '297',
    priceCurrency: 'CAD',
    description: "Diagnostic de visibilité Google + IA : 3 opportunités priorisées et 1 action immédiate, livrées en une page.",
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Qu'est-ce que le Flash Diagnostic, exactement ?",
      acceptedAnswer: { '@type': 'Answer', text: "Un diagnostic ciblé de votre visibilité en ligne, livré en une page : 3 opportunités priorisées et 1 action immédiate applicable dès la semaine suivante. Il couvre trois axes — votre présence Google (indexation, requêtes de catégorie, données structurées, signaux E-E-A-T), votre présence dans les réponses IA (ChatGPT, Perplexity, AI Overviews : votre site est-il accessible aux robots IA et votre contenu est-il citable ?) et les points de vigilance propres aux produits de santé (affichage du NPN, allégations, langue du site)." },
    },
    {
      '@type': 'Question',
      name: "Quelle différence avec l'audit complet à 997 $ ?",
      acceptedAnswer: { '@type': 'Answer', text: "Le Flash Diagnostic est un point de départ rapide : il identifie où sont vos plus grosses opportunités, sans tout couvrir. L'audit YMYL complet à 997 $ examine l'ensemble du site en profondeur (contenu, technique, E-E-A-T, conformité, GEO) et livre un rapport détaillé avec plan d'action. Le Flash sert souvent à décider, données en main, si l'audit complet vaut l'investissement — son montant est déductible de l'audit complet si vous poursuivez." },
    },
    {
      '@type': 'Question',
      name: 'Comment vérifiez-vous la visibilité dans ChatGPT et Perplexity ?',
      acceptedAnswer: { '@type': 'Answer', text: "Par des vérifications techniques réelles, pas des suppositions : accès de votre site testé avec les véritables robots des moteurs IA (GPTBot, ClaudeBot, PerplexityBot), analyse de vos données structurées (JSON-LD), de vos fichiers robots.txt et llms.txt, et de la citabilité de votre contenu (des passages factuels qu'une IA peut extraire et attribuer). Chaque constat du livrable est vérifié et reproductible." },
    },
    {
      '@type': 'Question',
      name: 'Est-ce un avis réglementaire sur mes allégations ?',
      acceptedAnswer: { '@type': 'Answer', text: "Non. Le volet conformité du diagnostic signale des points de vigilance marketing — NPN non affiché sur les fiches produits, allégation qui semble dépasser l'usage autorisé, site configuré dans la mauvaise langue ou le mauvais pays — pour que vous puissiez les faire valider. Ce n'est ni un avis juridique ni un avis réglementaire, et cela ne remplace pas vos affaires réglementaires." },
    },
    {
      '@type': 'Question',
      name: 'Pour quels types d’entreprises ?',
      acceptedAnswer: { '@type': 'Answer', text: "Les marques canadiennes de produits de santé naturels (vitamines, probiotiques, oméga-3, nutrition sportive), les dispositifs médicaux hors dermatologie et les entreprises pharmaceutiques. Je n'accepte pas de mandats en dermatologie, cosmétique ou soin de la peau, pour éviter tout conflit d'intérêts." },
    },
    {
      '@type': 'Question',
      name: 'Que se passe-t-il après le diagnostic ?',
      acceptedAnswer: { '@type': 'Answer', text: "Vous repartez avec un document actionnable, sans aucune obligation. Si vous voulez aller plus loin, la suite logique est l'audit YMYL complet (997 $) puis, au besoin, un accompagnement mensuel. Beaucoup d'entreprises appliquent simplement le quick win elles-mêmes — c'est très bien aussi : le diagnostic est conçu pour être utile seul." },
    },
  ],
};
---

<Layout lang={lang} title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Navbar lang={lang} />

  <main id="main-content">

    <!-- HERO ─────────────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden py-24 md:py-32" style="background: var(--color-primary);" aria-labelledby="diag-title">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 65% 60% at 70% 30%, rgba(202,138,4,0.14) 0%, transparent 65%);" aria-hidden="true"></div>
      <div class="container relative">
        <div class="max-w-3xl">
          <div class="badge-authority">297 $ CAD · Livré sous 7 jours ouvrables · Sans engagement</div>
          <h1 id="diag-title" class="text-white mb-6" style="font-size: clamp(2.25rem, 5.5vw, 3.5rem); line-height: 1.08; letter-spacing: -0.03em;">
            Flash Diagnostic —<br /><span style="color: var(--color-cta);">votre visibilité Google + IA, en une page.</span>
          </h1>
          <p class="mb-4" style="font-size: 0.9375rem; line-height: 1.65; color: rgba(255,255,255,0.55); font-style: italic;">
            Le Flash Diagnostic est un diagnostic de visibilité en ligne pour marques de santé canadiennes : Google, réponses IA et points de vigilance PSN, en un livrable d'une page.
          </p>
          <p class="mb-10" style="font-size: clamp(1rem, 1.8vw, 1.125rem); line-height: 1.7; color: rgba(255,255,255,0.73);">
            Quand un consommateur cherche votre catégorie de produits — sur Google <em>ou</em> dans ChatGPT — est-ce vous qu'il trouve ? Ce diagnostic répond à la question avec des <strong style="color: rgba(255,255,255,0.92);">constats vérifiés</strong>, puis vous donne <strong style="color: rgba(255,255,255,0.92);">3 opportunités priorisées et 1 action immédiate</strong>. Pas un rapport de 40 pages : une page utile.
          </p>
          <div class="flex flex-wrap gap-4 items-center">
            <a href="#contact" class="btn btn-primary btn-xl">Réserver mon Flash Diagnostic — 297 $</a>
            <a href="#perimetre" class="btn btn-ghost btn-xl">Ce qui est vérifié</a>
          </div>
        </div>
      </div>
    </section>

    <!-- PÉRIMÈTRE : LES 3 AXES ─────────────────────────────────────────────── -->
    <section id="perimetre" class="py-20 md:py-28" aria-labelledby="scope-title">
      <div class="container">
        <div class="section-header">
          <span class="overline">Le périmètre</span>
          <h2 class="section-title" id="scope-title">Trois axes vérifiés, zéro supposition</h2>
          <p class="section-lead">Chaque constat du livrable est vérifié techniquement et reproductible — jamais une impression, jamais un chiffre inventé.</p>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {[
            { t: '1. Votre présence Google', d: "Indexation réelle de vos pages clés, positionnement sur vos requêtes de catégorie, données structurées (JSON-LD), signaux de confiance E-E-A-T — les fondamentaux qui décident si Google vous montre." },
            { t: '2. Votre présence dans les IA', d: "Votre site est-il accessible aux robots des moteurs IA (GPTBot, ClaudeBot, PerplexityBot) ? Votre contenu est-il citable quand un consommateur interroge ChatGPT ou Perplexity sur votre catégorie ? Testé avec les vrais agents, pas estimé." },
            { t: '3. Vigilance produits de santé', d: "NPN affiché (ou non) sur vos fiches produits, allégations qui semblent dépasser l'usage autorisé, site configuré pour le mauvais pays ou la mauvaise langue — les angles morts fréquents des marques PSN, signalés pour validation." },
          ].map((s) => (
            <article style="background:white; border:1px solid var(--color-border); border-radius:1rem; padding:1.75rem;">
              <h3 style="font-size:1.0625rem; color:var(--color-primary); margin-bottom:0.5rem;">{s.t}</h3>
              <p style="font-size:0.9rem; color:var(--color-text-muted); line-height:1.65; margin:0;">{s.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- LE LIVRABLE ────────────────────────────────────────────────────────── -->
    <section class="py-20 md:py-28" style="background: var(--color-surface, #f8fafc);" aria-labelledby="deliv-title">
      <div class="container">
        <div class="section-header">
          <span class="overline">Le livrable</span>
          <h2 class="section-title" id="deliv-title">Une page. Trois opportunités. Une action immédiate.</h2>
          <p class="section-lead">Conçu pour un dirigeant ou une responsable marketing qui n'a pas le temps de lire un rapport de 40 pages.</p>
        </div>
        <div class="max-w-3xl mx-auto">
          <ul class="list-none m-0 p-0 flex flex-col gap-5">
            {[
              { t: '3 opportunités priorisées', d: "Les trois écarts qui, corrigés, ont le plus d'impact sur votre visibilité — classés par rapport effort/résultat, avec la preuve de chaque constat." },
              { t: '1 quick win actionnable', d: "Une action concrète que votre équipe peut appliquer dès la semaine suivante, sans moi." },
              { t: 'Présentation de 20 minutes (optionnelle)', d: "Je vous présente le diagnostic en visio ou au téléphone, et je réponds à vos questions. Sans argumentaire de vente." },
            ].map((item) => (
              <li style="background:white; border:1px solid var(--color-border); border-radius:1rem; padding:1.5rem 1.75rem;">
                <h3 style="font-size:1.0625rem; color:var(--color-primary); margin-bottom:0.4rem;">{item.t}</h3>
                <p style="font-size:0.9rem; color:var(--color-text-muted); line-height:1.65; margin:0;">{item.d}</p>
              </li>
            ))}
          </ul>
          <p style="margin-top:1.5rem; font-size:0.95rem; color:var(--color-text-muted);">
            Le montant du Flash Diagnostic est <strong style="color:var(--color-primary);">déductible de l'audit YMYL complet (997 $)</strong> si vous décidez d'aller plus loin. → Voir <a href="/seo-psn/" style="color:var(--color-cta); font-weight:600;">le SEO pour marques de PSN</a> et <a href="/seo-pharma/" style="color:var(--color-cta); font-weight:600;">le SEO pharma conforme</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- OFFRE DE LANCEMENT ─────────────────────────────────────────────────── -->
    <section class="py-16 md:py-20" aria-labelledby="launch-title">
      <div class="container">
        <div class="max-w-3xl mx-auto" style="background: var(--color-primary); border-radius: 1.25rem; padding: 2.5rem;">
          <span class="overline" style="color: #FCD34D;">Offre de lancement</span>
          <h2 id="launch-title" style="color: white; font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.2; margin-bottom: 0.75rem;">
            197 $ pour les 2 premières marques
          </h2>
          <p style="color: rgba(255,255,255,0.73); line-height: 1.7; font-size: 1rem; margin-bottom: 1.5rem;">
            Les deux premières entreprises qui réservent obtiennent le Flash Diagnostic à <strong style="color: white;">197 $ au lieu de 297 $</strong>, en échange d'un témoignage honnête et du droit d'en faire une étude de cas anonymisée. Même livrable, même rigueur.
          </p>
          <a href="#contact" class="btn btn-primary btn-xl">Prendre une des 2 places</a>
        </div>
      </div>
    </section>

    <!-- FAQ ────────────────────────────────────────────────────────────────── -->
    <section class="py-20 md:py-28" style="background: var(--color-surface, #f8fafc);" aria-labelledby="faq-title">
      <div class="container">
        <div class="section-header">
          <span class="overline">FAQ</span>
          <h2 class="section-title" id="faq-title">Questions fréquentes</h2>
        </div>
        <div class="max-w-3xl mx-auto">
          {faqSchema.mainEntity.map((q) => (
            <details style="border-bottom:1px solid var(--color-border); padding:1.25rem 0;">
              <summary style="font-weight:600; color:var(--color-primary); cursor:pointer; font-size:1.0625rem;">{q.name}</summary>
              <p style="margin-top:0.75rem; color:var(--color-text-muted); line-height:1.7; font-size:0.95rem;">{q.acceptedAnswer.text}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Booking lang={lang} />
    <ContactCTA lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
